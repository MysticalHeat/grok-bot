TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Legacy filename; model requests now use OpenRouter.
AI_BACKEND=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key
GEMINI_MODEL=x-ai/grok-4.3
SYSTEM_PROMPT_ENABLED=false
TRIGGER_ALIAS=@grok
SYSTEM_PROMPT_FILE=prompts/grok-balanced.txt
