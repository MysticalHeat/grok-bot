TELEGRAM_BOT_TOKEN=your_telegram_bot_token
AI_BACKEND=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key
TAVILY_API_KEY=your_tavily_api_key
GEMINI_MODEL=x-ai/grok-4.3
CAFETERIA_PREP_ENABLED=true
CAFETERIA_MODEL=google/gemini-3.8-flash
CAFETERIA_REFRESH_MINUTES=60
CAFETERIA_DAYS_AHEAD=14
# HTTP только на localhost; включить после настройки HTTPS и Main Mini App в BotFather.
# MENU_LISTEN_ADDR=127.0.0.1:8080
TRIGGER_ALIAS=@grok
SYSTEM_PROMPT_FILE=prompts/grok-balanced.txt
# SYSTEM_PROMPT=Отвечай кратко и по делу на русском языке, если пользователь не просит иначе.
MAX_HISTORY_MESSAGES=12
SEARCH_MAX_RESULTS=5
MAX_IMAGE_BYTES=8388608
SQLITE_PATH=bot.db
POLL_TIMEOUT_SECONDS=30
# Списки через запятую; пусто — доступ разрешён всем
# ALLOWED_USER_IDS=123456789,987654321
# ALLOWED_GROUP_IDS=-1001234567890
